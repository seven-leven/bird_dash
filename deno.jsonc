{
  "tasks": {
    // ── Development ──────────────────────────────────────────────────────────
    "dev": "deno run -A --node-modules-dir npm:vite",
    "preview": "deno run -A --node-modules-dir npm:vite preview",

    // ── Build ─────────────────────────────────────────────────────────────────
    // Full build: transcode images → build frontend (the version is derived, not bumped)
    "build": "deno run -A ./script/build.ts",

    // Individual stages (also callable from CI separately)
    "build:assets": "deno run -A ./script/build.ts --assets-only",
    "build:vite": "deno run -A ./script/build.ts --vite-only",

    // ── Tests ─────────────────────────────────────────────────────────────────
    // Runs every tier and prints one row per tier (script/test.ts); the tier of a
    // test file comes from its name (script/test/tiers.ts). Pass tier names to run
    // a subset: `deno task test unit dom`, or use the shortcuts below.
    "test": "deno run -A ./script/test.ts",
    "test:unit": "deno run -A ./script/test.ts unit",
    "test:dom": "deno run -A ./script/test.ts dom",
    "test:prop": "deno run -A ./script/test.ts prop",
    "test:contract": "deno run -A ./script/test.ts contract",
    // Re-run on every save while developing (Deno's own output, one line per test).
    "test:watch": "deno test -A --node-modules-dir --watch src/ script/",
    // Every tier + a coverage table; fails if total line coverage drops below the
    // floor. Raise --min-lines as coverage grows (it only ratchets up).
    "test:coverage": "deno run -A ./script/test.ts --coverage --min-lines=90",

    // ── Type check ────────────────────────────────────────────────────────────
    // Deno type-checks the .ts surface (scripts, composables, types, entrypoint).
    // .vue SFCs are not covered — Volar/vue-tsc doesn't engage under Deno's npm
    // compat, so template + <script setup> checking would be a false green.
    "typecheck": "deno check script/**/*.ts src/**/*.ts",

    // ── Integrity ─────────────────────────────────────────────────────────────
    "check": "deno run -A ./script/build.ts --check",

    // ── Versioning & changelog ────────────────────────────────────────────────
    // The version is derived from script/version/version.json + git + the data (script/version/compute.ts);
    // see the README, "Versioning". `--long` also prints the drawing count and commit.
    "version": "deno run -A ./script/version/compute.ts",
    // Insert commits made since CHANGELOG.md was last touched at the top of the newest section
    "changelog": "deno run -A ./script/changelog.ts",

    // ── Utilities ─────────────────────────────────────────────────────────────
    // Redraw public/placeholders/<id>.webp from each collection's line icon
    "placeholders": "deno run -A --node-modules-dir ./script/placeholders/generate.ts",
    // Redraw docs/design-guide.png, docs/icons.png and the logo files (see docs/DESIGN.md)
    "design": "deno run -A --node-modules-dir ./script/docs/design_guide.ts",
    "serve": "deno run --allow-net --allow-read jsr:@std/http/file-server dist/",
    "clean": "rm -rf dist node_modules",
    "lint": "deno lint",
    "format": "deno fmt"
  },

  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitThis": true,
    "verbatimModuleSyntax": true
  },

  "lint": {
    "exclude": ["dist", "node_modules", "public/full", "public/thumb", "raw_png"]
  },

  "fmt": {
    // docs/logo holds generated SVG files; the generator, not the formatter, owns their layout
    "exclude": ["dist", "node_modules", "public/full", "public/thumb", "raw_png", "docs/logo"],
    "singleQuote": true,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "proseWrap": "always"
  },

  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "sharp": "npm:sharp@0.34.5",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1",
    "@std/path": "jsr:@std/path@^1.1.4",
    // Test-only: a browser-like global environment and property-based testing.
    "@happy-dom/global-registrator": "npm:@happy-dom/global-registrator@^18",
    "fast-check": "npm:fast-check@^4",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^6.0.6",
    "tailwindcss": "npm:tailwindcss@^4.3.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.0",
    "vite": "npm:vite@^8.0.12",
    "vue": "npm:vue@^3.5.34",
    "@vue/reactivity": "npm:@vue/reactivity@3.5.34",
    "@vue/runtime-core": "npm:@vue/runtime-core@3.5.34",
    "@vue/runtime-dom": "npm:@vue/runtime-dom@3.5.34",
    "@vue/compiler-dom": "npm:@vue/compiler-dom@3.5.34",
    "@vue/shared": "npm:@vue/shared@3.5.34"
  },

  "nodeModulesDir": "auto",

  "allowScripts": {
    // sharp requires a native binary install step
    "allow": ["npm:sharp@0.34.5"]
  }
}
