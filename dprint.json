{
  // The same formatter engines and settings `deno fmt` used, so the switch moved no lines.
  "lineWidth": 100,
  "indentWidth": 2,
  "typescript": {
    "deno": true,
    "lineWidth": 100,
    "quoteStyle": "preferSingle"
  },
  "json": {
    "deno": true,
    "lineWidth": 100
  },
  "markdown": {
    "deno": true,
    "lineWidth": 100,
    "textWrap": "always"
  },
  "malva": { "quotes": "preferSingle" },
  "markup": {},
  "yaml": { "quotes": "preferSingle" },
  // docs/assets/logo holds generated SVG files; the generator, not the formatter, owns their layout
  "excludes": [
    "dist",
    "node_modules",
    "public/full",
    "public/thumb",
    "raw_png",
    "test-results",
    "docs/assets/logo",
    "package.json",
    "package-lock.json",
    "**/*.vue"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/markdown-0.22.0.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.5.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
