{
  "name": "bird-dash",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "node script/build.ts",
    "build:assets": "node script/build.ts --assets-only",
    "build:vite": "node script/build.ts --vite-only",
    "test": "node script/test.ts",
    "test:unit": "node script/test.ts unit",
    "test:dom": "node script/test.ts dom",
    "test:prop": "node script/test.ts prop",
    "test:contract": "node script/test.ts contract",
    "test:watch": "vitest",
    "test:coverage": "node script/test.ts --coverage --min-lines=91",
    "test:report": "node script/test.ts --coverage --min-lines=91 --report",
    "test:html": "node script/test.ts --coverage --min-lines=91 --report --html",
    "typecheck": "vue-tsc --noEmit",
    "check": "node script/build.ts --check",
    "version": "node script/version/compute.ts",
    "changelog": "node script/changelog.ts",
    "placeholders": "node script/placeholders/generate.ts",
    "design": "node script/docs/design_guide.ts",
    "serve": "vite preview --outDir dist",
    "clean": "node -e \"for (const d of ['dist', 'node_modules']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "lint": "eslint .",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^18.0.1",
    "@std/assert": "npm:@jsr/std__assert@^1.0.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^5.0.5",
    "dprint": "^0.63.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "dprint@0.63.0": true,
    "sharp@0.34.5": true
  }
}
