{
  "name": "bird-dash",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "node script/build/build.ts",
    "build:site": "node script/build/build.ts site",
    "build:docs": "node script/build/build.ts docs",
    "ingest": "node script/ingest/ingest.ts",
    "test": "node script/testRunner/testRunner.ts",
    "test:unit": "node script/testRunner/testRunner.ts unit",
    "test:dom": "node script/testRunner/testRunner.ts dom",
    "test:journey": "node script/testRunner/testRunner.ts journey",
    "test:prop": "node script/testRunner/testRunner.ts prop",
    "test:contract": "node script/testRunner/testRunner.ts contract",
    "test:watch": "vitest",
    "test:coverage": "node script/testRunner/testRunner.ts --coverage --min-lines=100 --min-branches=100",
    "test:report": "node script/testRunner/testRunner.ts --coverage --min-lines=100 --min-branches=100 --report",
    "test:html": "node script/testRunner/testRunner.ts --coverage --min-lines=100 --min-branches=100 --report --html",
    "typecheck": "vue-tsc --noEmit",
    "check": "node script/check/check.ts",
    "version": "node script/version/version.ts",
    "changelog": "node script/changelog/changelog.ts",
    "generate": "node script/generate/generate.ts",
    "serve": "vite preview --outDir dist",
    "clean": "node -e \"for (const d of ['dist', 'node_modules']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "lint": "eslint .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "dprint": "0.64.3",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "dprint@0.64.3": true
  }
}
